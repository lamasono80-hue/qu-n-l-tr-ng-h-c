# ==============================================================================
# UniConnect – Environment Configuration Template
# Strictly for local/development & deployment configuration.
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO SOURCE CONTROL!
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Configuration (PostgreSQL 15+)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/uniconnect_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=uniconnect_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Authentication & JWT Security (NFR-SEC-001)
JWT_SECRET=replace_with_a_secure_random_secret_minimum_32_chars_long
JWT_EXPIRES_IN=86400

# Institutional Email Policy (FR-AUTH-001)
INSTITUTION_EMAIL_DOMAIN_REGEX=^[A-Za-z0-9._%+-]+@([A-Za-z0-9.-]+\.)*edu\.vn$
INSTITUTION_DEFAULT_DOMAIN=university.edu.vn

# Default Administrator Seed Configuration (Phase 4 Section 6.1)
# MANDATORY: Generate a bcrypt hash for the initial administrator password during deployment.
# Example: Generate hash using bcrypt-cli or an external script (e.g. bcrypt.hashSync('your_password', 12))
SEED_ADMIN_EMAIL=admin@uniconnect.edu.vn
SEED_ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash_of_admin_password
